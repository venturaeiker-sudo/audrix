// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== TENANT Y SUCURSALES =====
model tenants {
  id            String   @id @default(cuid())
  name          String   // Nombre del concesionario
  rnc           String   @unique // RNC fiscal
  email         String
  phone         String
  address       String
  logo_url      String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  branches               branches[]
  users                  users[]
  roles                  roles[]
  permissions            permissions[]
  permission_templates   permission_templates[]
  status_definitions     status_definitions[]
  audit_logs             audit_logs[]
  notification_templates notification_templates[]
  customers              customers[]
  cash_sessions          cash_sessions[]
  vehicles               vehicles[]
  financing_contracts    financing_contracts[]
  loan_payments          loan_payments[]
  payments               payments[]
  inventory_items        inventory_items[]
  vehicle_registrations  vehicle_registrations[]

  @@index([name])
}

model branches {
  id          String    @id @default(cuid())
  tenant_id   String
  name        String    // Ej: "Sucursal Santo Domingo Oeste"
  code        String    @unique // Código corto único global: "SDO"
  email       String
  phone       String
  address     String
  is_active   Boolean   @default(true)
  opened_at   DateTime
  closed_at   DateTime?

  tenant                tenants               @relation(fields: [tenant_id], references: [id])
  users                 users[]
  cash_sessions         cash_sessions[]
  customers             customers[]
  financing_contracts   financing_contracts[]
  loan_payments         loan_payments[]
  payments              payments[]
  vehicle_registrations vehicle_registrations[]

  @@index([tenant_id, code])
  @@index([tenant_id, is_active])
}

// ===== USUARIOS Y ROLES =====
model users {
  id            String    @id @default(cuid())
  tenant_id     String
  branch_id     String?   // Null = acceso a todo el tenant
  email         String    @unique // Único global (un email = una cuenta)
  password      String    // Hash
  first_name    String
  last_name     String
  phone         String?
  is_active     Boolean   @default(true)
  is_verified   Boolean   @default(false)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  tenant             tenants         @relation(fields: [tenant_id], references: [id])
  branch             branches?       @relation(fields: [branch_id], references: [id])
  roles              user_roles[]
  cash_sessions      cash_sessions[] // Sesiones que abrió/cerró
  audit_logs         audit_logs[]   // Acciones que realizó
  assigned_customers customers[]    @relation("AssignedUser")
  received_payments  payments[]     @relation("ReceivedByUser")

  @@index([tenant_id, email])
  @@index([tenant_id, is_active])
}

model roles {
  id          String   @id @default(cuid())
  tenant_id   String
  name        String   // Ej: "Admin", "Cajero", "Vendedor"
  description String?
  is_system   Boolean  @default(false) // No se puede eliminar si es sistema
  created_at  DateTime @default(now())

  tenant      tenants            @relation(fields: [tenant_id], references: [id])
  permissions role_permissions[]
  users       user_roles[]

  @@unique([tenant_id, name])
  @@index([tenant_id, is_system])
}

model permissions {
  id          String  @id @default(cuid())
  tenant_id   String
  resource    String  // Ej: "customers", "cash-sessions", "roles"
  action      String  // Ej: "create", "read", "update", "delete", "export"
  description String?

  tenant           tenants            @relation(fields: [tenant_id], references: [id])
  role_permissions role_permissions[]

  @@unique([tenant_id, resource, action])
  @@index([tenant_id, resource])
}

model role_permissions {
  id            String @id @default(cuid())
  role_id       String
  permission_id String

  role       roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
}

model user_roles {
  id          String   @id @default(cuid())
  user_id     String
  role_id     String
  assigned_by String?  // Usuario que asignó el rol
  assigned_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role roles @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
}

// ===== CLIENTE 360 BASE =====
model customers {
  id                    String    @id @default(cuid())
  tenant_id             String
  branch_id             String?   // Sucursal principal (null = tenant-wide)
  first_name            String
  last_name             String
  email                 String?
  phone                 String
  identification_type   String?   // cédula, pasaporte, rnc
  identification_number String?
  address               String?
  city                  String?
  status                String    @default("active") // Vinculado a status_definitions
  assigned_to           String?   // Usuario responsable (ventas/cobranza)
  credit_score          Int?      // 0-1000, calculado posteriormente
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  tenant        tenants   @relation(fields: [tenant_id], references: [id])
  branch        branches? @relation(fields: [branch_id], references: [id])
  assigned_user users?    @relation("AssignedUser", fields: [assigned_to], references: [id])

  vehicles              vehicles[]
  financing_contracts   financing_contracts[]
  vehicle_registrations vehicle_registrations[]
  payments              payments[]

  @@index([tenant_id, identification_number])
  @@index([tenant_id, status])
  @@index([tenant_id, assigned_to])
}

// ===== ESTADOS DINÁMICOS (CLAVE PARA ESCALABILIDAD) =====
model status_definitions {
  id          String   @id @default(cuid())
  tenant_id   String
  entity_type String   // Ej: "customer", "contract", "cash_session", "vehicle_registration"
  code        String   // Código corto: "active", "past_due", "plate_ready"
  label       String   // Etiqueta para mostrar: "Activo", "Vencido", "Placa Lista"
  color       String   // Hex code: "#28a745", "#dc3545", "#ffc107"
  is_initial  Boolean  @default(false) // Estado de creación
  is_final    Boolean  @default(false) // Estado terminal (no se puede salir)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  tenant tenants @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, entity_type, code])
  @@index([tenant_id, entity_type, is_active])
}

// ===== CAJA (FUNDAMENTAL PARA CONTROL FINANCIERO) =====
model cash_sessions {
  id             String    @id @default(cuid())
  tenant_id      String
  branch_id      String
  user_id        String    // Usuario que abrió la sesión
  opened_at      DateTime  @default(now())
  closed_at      DateTime?
  status         String    @default("open") // open/closed
  opening_amount Decimal   @default(0) @db.Decimal(12, 2)
  closing_amount Decimal?  @db.Decimal(12, 2) // Se calcula al cerrar
  total_payments Decimal   @default(0) @db.Decimal(12, 2)
  notes          String?

  tenant        tenants       @relation(fields: [tenant_id], references: [id])
  branch        branches      @relation(fields: [branch_id], references: [id])
  user          users         @relation(fields: [user_id], references: [id])
  payments      payments[]
  loan_payments loan_payments[]

  @@index([tenant_id, branch_id, status])
  @@index([tenant_id, user_id])
}

// ===== PAGOS (VINCULADOS A CAJA) =====
model payments {
  id               String   @id @default(cuid())
  tenant_id        String
  branch_id        String
  cash_session_id  String
  customer_id      String?  // Null = pago sin cliente (ej: pago de proveedor)
  amount           Decimal  @db.Decimal(12, 2)
  method           String   // cash, card, transfer, check
  reference_number String?  // Número de cheque, referencia de transferencia
  received_at      DateTime @default(now())
  received_by      String?  // Usuario que recibió el pago (puede ser distinto al que abrió caja)
  notes            String?

  tenant           tenants       @relation(fields: [tenant_id], references: [id])
  branch           branches      @relation(fields: [branch_id], references: [id])
  cash_session     cash_sessions @relation(fields: [cash_session_id], references: [id])
  customer         customers?    @relation(fields: [customer_id], references: [id])
  received_by_user users?        @relation("ReceivedByUser", fields: [received_by], references: [id])

  @@index([tenant_id, cash_session_id])
  @@index([tenant_id, customer_id, received_at])
}

// ===== AUDITORÍA BÁSICA =====
model audit_logs {
  id           String   @id @default(cuid())
  tenant_id    String
  user_id      String   // Usuario que realizó la acción
  entity_type  String   // Modelo afectado: "customers", "cash-sessions", "roles"
  entity_id    String   // ID del registro afectado
  action       String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  changes_json Json?    // { antes: {...}, después: {...} } para UPDATE
  ip_address   String?
  user_agent   String?
  created_at   DateTime @default(now())

  tenant tenants @relation(fields: [tenant_id], references: [id])
  user   users   @relation(fields: [user_id], references: [id])

  @@index([tenant_id, entity_type, entity_id])
  @@index([tenant_id, user_id, created_at])
}

// ===== PLANTILLAS DE NOTIFICACIONES (BASE PARA FASE 1) =====
model notification_templates {
  id               String   @id @default(cuid())
  tenant_id        String
  code             String   @unique // payment_receipt, cash_close, plate_ready
  name             String
  subject_template String
  html_template    String
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tenant tenants @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, code])
}

// ===== TABLAS DE SOPORTE (para evitar hardcodeo) =====
model permission_templates {
  id          String  @id @default(cuid())
  tenant_id   String
  resource    String
  action      String
  description String?
  is_active   Boolean @default(true)

  tenant tenants @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, resource, action])
}

// ===== VEHÍCULOS (BASE PARA FASES POSTERIORES) =====
model vehicles {
  id             String  @id @default(cuid())
  tenant_id      String
  customer_id    String? // Null = en inventario; set al vender/financiar
  vin            String? // 17 caracteres, único global si existe
  chassis_number String? // Número de chassi (para vehículos sin VIN)
  license_plate  String  @unique // Placa única global (emitida por gobierno)
  color          String
  make           String
  model          String
  year           Int
  status         String  // in_stock, reserved, sold (vinculado a status_definitions)

  tenant                tenants               @relation(fields: [tenant_id], references: [id])
  customer              customers?            @relation(fields: [customer_id], references: [id])
  financing_contracts   financing_contracts[]
  vehicle_registrations vehicle_registrations[]

  @@index([tenant_id, vin])
  @@index([tenant_id, chassis_number])
  @@index([tenant_id, license_plate])
}

// ===== CONTRATOS DE FINANCIAMIENTO (BASE) =====
model financing_contracts {
  id                String  @id @default(cuid())
  tenant_id         String
  branch_id         String
  customer_id       String
  vehicle_id        String? // Vinculado al vehículo financiado
  contract_number   String  @unique
  total_amount      Decimal @db.Decimal(12, 2)
  initial_amount    Decimal @db.Decimal(12, 2)
  initial_received  Decimal @default(0) @db.Decimal(12, 2)
  remaining_balance Decimal @default(0) @db.Decimal(12, 2)
  interest_rate     Decimal @db.Decimal(5, 4) // Tasa mensual (ej: 0.0300 para 3%)
  term_months       Int
  status            String  // Vinculado a status_definitions

  tenant        tenants     @relation(fields: [tenant_id], references: [id])
  branch        branches    @relation(fields: [branch_id], references: [id])
  customer      customers   @relation(fields: [customer_id], references: [id])
  vehicle       vehicles?   @relation(fields: [vehicle_id], references: [id])
  loan_payments loan_payments[]

  @@index([tenant_id, contract_number])
  @@index([tenant_id, customer_id, status])
}

// ===== PAGOS DE PRESTAMO =====
model loan_payments {
  id               String    @id @default(cuid())
  tenant_id        String
  branch_id        String
  contract_id      String
  cash_session_id  String?   // Vinculado a caja si se pagó en sucursal
  payment_number   Int       // ¿Cuál cuota es? (1, 2, 3...)
  payment_type     String    // initial, installment, extra_payment
  amount           Decimal   @db.Decimal(12, 2)
  payment_date     DateTime  @default(now())
  method           String    // cash, card, transfer
  reference_number String?   // Número de recibo
  receipt_sent     Boolean   @default(false)

  tenant       tenants             @relation(fields: [tenant_id], references: [id])
  branch       branches            @relation(fields: [branch_id], references: [id])
  contract     financing_contracts @relation(fields: [contract_id], references: [id])
  cash_session cash_sessions?      @relation(fields: [cash_session_id], references: [id])

  @@index([tenant_id, contract_id, payment_date])
}

// ===== SÍMBOLOS DE RELACIÓN (para evitar errores) =====
// Los modelos siguientes se usarán en fases posteriores pero se definen aquí para completitud
model inventory_items {
  id         String  @id @default(cuid())
  tenant_id  String
  sku        String  @unique
  name       String
  category   String
  quantity   Int
  cost_price Decimal @db.Decimal(12, 2)
  sale_price Decimal @db.Decimal(12, 2)
  status     String

  tenant tenants @relation(fields: [tenant_id], references: [id])
}

model vehicle_registrations {
  id                  String  @id @default(cuid())
  tenant_id           String
  branch_id           String
  customer_id         String
  vehicle_id          String  // Vinculado al vehículo (para saber qué placa/matrícula)
  status              String  // pending_dgii, plate_ready, delivered, completed
  assigned_employee   String?
  chassis_vin         String
  rnc_owner           String
  plate_number        String?
  registration_number String?

  tenant   tenants   @relation(fields: [tenant_id], references: [id])
  branch   branches  @relation(fields: [branch_id], references: [id])
  customer customers @relation(fields: [customer_id], references: [id])
  vehicle  vehicles  @relation(fields: [vehicle_id], references: [id])
}

// NOTA: Los modelos de auditoría, notificaciones y estados dinámicos son transversales
// y se usarán en TODAS las fases posteriores sin modificar su estructura
